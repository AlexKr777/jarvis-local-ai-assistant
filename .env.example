# This file documents optional environment variables. JARVIS does not load .env
# automatically; set values in the process or user environment instead.
# AI authentication stays in the local Codex App Server / ChatGPT session.
# Do not add OPENAI_API_KEY.

# Local HTTP server and speech recognition.
JARVIS_PORT=3210
JARVIS_ASR_MODEL=small
JARVIS_ASR_DEVICE=cpu
JARVIS_ASR_COMPUTE_TYPE=int8

# Crypto runtime: OFF | DRY_RUN | AUTO. DRY_RUN is the safe default.
JARVIS_CRYPTO_MODE=DRY_RUN
JARVIS_CRYPTO_SCANNER_ENABLED=1
JARVIS_CRYPTO_TOP_RUNNER_MODE=1
JARVIS_CRYPTO_REQUIRE_SCORE_FOR_LIVE_RUNNER=0
JARVIS_CRYPTO_MAX_POSTS_24H=10
JARVIS_CRYPTO_COMPETITION_WINDOW_MS=0
JARVIS_CRYPTO_DEEP_ANALYSIS_CONCURRENCY=2
JARVIS_CRYPTO_DEEP_ANALYSIS_PER_SYMBOL_COOLDOWN_MS=60000
JARVIS_CRYPTO_DEEP_ANALYSIS_QUEUE_LIMIT=1
JARVIS_CRYPTO_SCANNER_INTERVAL_MS=60000

# Local Ollama is the default writer. Use anymodel only with a locally supplied key.
JARVIS_CRYPTO_WRITER_PROVIDER=ollama
CRYPTO_WRITER_MODEL=gemma4:12b-it-q4_K_M
CRYPTO_WRITER_BASE_URL=http://127.0.0.1:11434
JARVIS_CRYPTO_ANYMODEL_BASE_URL=https://anymodel.org/v1
JARVIS_CRYPTO_ANYMODEL_MODEL=kmc/k3
ANYMODEL_API_KEY=

# Required only when JARVIS_CRYPTO_MODE=AUTO. Never commit a real value.
BINANCE_SQUARE_OPENAPI_KEY=

# Conservative public Binance REST limits.
BINANCE_REST_MAX_CONCURRENCY=1
BINANCE_REST_MIN_INTERVAL_MS=750
BINANCE_REST_QUEUE_LIMIT=24
BINANCE_REST_MAX_QUEUE_AGE_MS=30000
